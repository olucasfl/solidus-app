// Schema do Solidus. Ainda SEM models de negocio (base de infraestrutura apenas) — cada model
// entra junto da spec que o justifica (01-fundacao-auth e a primeira).
//
// Padrao de RLS obrigatorio (ARCHITECTURE.md secao de banco): toda migration que CRIA uma tabela
// termina com, para aquela tabela:
//   ALTER TABLE "NomeDaTabela" ENABLE ROW LEVEL SECURITY;
//   REVOKE ALL ON "NomeDaTabela" FROM anon, authenticated;
// Sem policy nenhuma — o Prisma conecta como role `postgres` (dono do schema) e ignora RLS; o RLS
// aqui existe so para fechar a Data API do Supabase (nao usada por este projeto) e qualquer acesso
// futuro por anon/authenticated. `pnpm db:check-rls` falha o CI/local se alguma tabela ficar sem
// RLS ou com grant residual para essas duas roles.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Transaction pooler (6543, pgbouncer=true&connection_limit=1) — usado em runtime pela API.
  url       = env("DATABASE_URL")
  // Session pooler (5432) — usado só pelo Prisma Migrate (migrations precisam de sessão longa).
  directUrl = env("DIRECT_URL")
}

// Usuário do app (spec 01 e 06). Só existe o do seed: o app é de uso pessoal e não terá cadastro
// público (spec 06 obsoleta). Todo dado financeiro pertence a um usuário (`userId`).
model User {
  id           String        @id @default(uuid())
  email        String        @unique @db.VarChar(254)
  senhaHash    String        @db.VarChar(255)
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt
  // null = USUARIO. ADMIN edita o que é global (tabelas de imposto).
  papel        PapelUsuario?

  sessoes             RefreshSession[]
  contas              Conta[]
  transacoes          Transacao[]
  syncRuns            SyncRun[]
  regras              RegraCategoria[]
  caixinhas           Caixinha[]
  movimentos          MovimentoCaixinha[]
  fontesRenda         FonteRenda[]
  conexaoPluggy       ConexaoPluggy?
  configuracaoReserva ConfiguracaoReserva?
}

enum PapelUsuario {
  USUARIO
  ADMIN
}

enum ClienteSessao {
  WEB
  PWA
}

// Uma sessão por login/dispositivo (múltiplas sessões simultâneas). O token em claro NUNCA é
// gravado — só o hash SHA-256 (hex, 64 chars), igual qualquer outro segredo de uso único.
// expiraEm null = sessão PWA, sem TTL por tempo (só revogada por logout, reuso detectado, ou
// limpeza manual direto no banco — spec 01-fundacao-auth, "Fora de escopo").
model RefreshSession {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cliente    ClienteSessao
  tokenHash  String        @db.Char(64)
  criadoEm   DateTime      @default(now())
  expiraEm   DateTime?
  revogadoEm DateTime?

  @@index([userId])
  @@index([tokenHash])
}

// --- Sync com o Pluggy (spec 02-sync-pluggy). Dinheiro sempre em centavos (Int). ---

enum TipoConta {
  CORRENTE
  POUPANCA
  CARTAO
}

enum TipoTransacao {
  DEBITO
  CREDITO
}

enum StatusTransacao {
  PENDENTE
  EFETIVADA
}

enum StatusSync {
  SUCESSO
  FALHA
}

model Conta {
  id              String      @id @default(uuid())
  // dono do dado (spec 06): o código SEMPRE filtra por ele (o Prisma ignora o RLS do Postgres)
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pluggyAccountId String      @unique
  tipo            TipoConta
  nome            String      @db.VarChar(120)
  saldoCentavos   Int
  moeda           String      @db.VarChar(3)
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt
  transacoes      Transacao[]

  @@index([userId])
}

model Transacao {
  id                      String             @id @default(uuid())
  // dono do dado (spec 06): o código SEMPRE filtra por ele (o Prisma ignora o RLS do Postgres)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pluggyTransactionId     String             @unique
  contaId                 String
  conta                   Conta              @relation(fields: [contaId], references: [id], onDelete: Cascade)
  data                    DateTime
  descricao               String             @db.VarChar(500)
  // negativo = saída, positivo = entrada; o sinal vem do `type` do Pluggy, nunca do valor cru
  valorCentavos           Int
  tipo                    TipoTransacao
  status                  StatusTransacao
  moeda                   String             @db.VarChar(3)
  // dado auxiliar do Pluggy; a categoria do Solidus vem da spec 03-categorizacao
  categoriaPluggy         String?            @db.VarChar(120)
  // categoria do Solidus (id da taxonomia em packages/shared, validado no código) — spec 03
  categoria               String?            @db.VarChar(40)
  origemCategoria         OrigemCategoria?
  // spec 07: quem pagou (entrada) ou recebeu (saída). Chave = HMAC do documento (nunca em claro);
  // nome e máscara só servem para exibir. Nulos quando o Pluggy não manda documento.
  contraparteChave        String?            @db.VarChar(64)
  contraparteNome         String?            @db.VarChar(200)
  contraparteDocMascarado String?            @db.VarChar(20)
  criadoEm                DateTime           @default(now())
  atualizadoEm            DateTime           @updatedAt
  movimentoCaixinha       MovimentoCaixinha?

  @@index([contaId, data])
  @@index([userId, contraparteChave])
  @@index([userId, data])
  @@index([data])
  @@index([categoria])
}

model SyncRun {
  id                    String     @id @default(uuid())
  // dono do dado (spec 06): o código SEMPRE filtra por ele (o Prisma ignora o RLS do Postgres)
  userId                String?
  user                  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  iniciadoEm            DateTime   @default(now())
  finalizadoEm          DateTime?
  status                StatusSync
  contas                Int        @default(0)
  transacoesNovas       Int        @default(0)
  transacoesAtualizadas Int        @default(0)
  // só o code do erro (ex.: PLUGGY_INDISPONIVEL), nunca a mensagem do Pluggy
  erro                  String?    @db.VarChar(60)

  @@index([userId, iniciadoEm])
}

// --- Categorização (spec 03-categorizacao) ---

enum OrigemCategoria {
  REGRA_USUARIO
  REGRA_PADRAO
  MANUAL
  // spec 07: a categoria veio de uma fonte de renda (salário marcado ou pagador recorrente)
  FONTE_RENDA
}

// --- Fontes de renda (spec 07-salario-e-pix-automatico) ---

enum TipoFonteRenda {
  SALARIO
  RECORRENTE
}

enum OrigemFonteRenda {
  MANUAL
  AUTOMATICA
}

// Uma origem (contraparte) que paga renda. `contraparteChave` é o HMAC do documento de quem paga: o
// CPF/CNPJ nunca é gravado em claro, e a chave não sai da API (nenhum DTO a devolve).
model FonteRenda {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo             TipoFonteRenda
  origem           OrigemFonteRenda
  contraparteChave String           @db.VarChar(64)
  nome             String?          @db.VarChar(200)
  docMascarado     String?          @db.VarChar(20)
  // por DIA (UTC); `vigenteAte` nulo = sem fim. Trocar a origem encerra a antiga e abre a nova.
  vigenteDesde     DateTime
  vigenteAte       DateTime?
  ativa            Boolean          @default(true)
  criadoEm         DateTime         @default(now())
  atualizadoEm     DateTime         @updatedAt

  @@index([userId, contraparteChave])
}

model RegraCategoria {
  id               String         @id @default(uuid())
  // dono do dado (spec 06): o código SEMPRE filtra por ele (o Prisma ignora o RLS do Postgres)
  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  padrao           String         @db.VarChar(120)
  categoria        String         @db.VarChar(40)
  tipo             TipoTransacao?
  // faixa opcional sobre o MÓDULO do valor (ex.: salário ≈ R$ 1.044), em centavos
  valorMinCentavos Int?
  valorMaxCentavos Int?
  prioridade       Int            @default(0)
  criadoEm         DateTime       @default(now())

  @@index([userId])
}

// --- Carteira por Caixinha (spec 05-carteira-caixinhas). Nada fixo no código: Caixinhas, percentuais e
// alíquotas de IR/IOF são dados editáveis. Dinheiro em centavos (Int); CDI como inteiro x10^8. ---

model Caixinha {
  id                  String               @id @default(uuid())
  // dono do dado (spec 06): o código SEMPRE filtra por ele (o Prisma ignora o RLS do Postgres)
  userId              String?
  user                User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome                String               @db.VarChar(60)
  // 11500 = 115% do CDI; 0 = não rende
  percentualCdiBp     Int
  // conta no patrimônio, mas é verba para gastar no mês (não é "investido")
  reservaDeGastos     Boolean              @default(false)
  // spec reserva-emergencia: faz parte da reserva de EMERGÊNCIA (não confundir com reservaDeGastos, que é verba do mês)
  reservaEmergencia   Boolean              @default(false)
  // null = convenção padrão do app; o usuário muda se a conferência (GET /caixinhas/:id/conferencia)
  // mostrar que o banco dele credita de outro jeito
  convencaoRendimento ConvencaoRendimento?
  ativa               Boolean              @default(true)
  criadoEm            DateTime             @default(now())
  atualizadoEm        DateTime             @updatedAt
  movimentos          MovimentoCaixinha[]

  @@index([userId])
}

// Em que ordem, no mesmo dia, entram aporte/resgate e o rendimento do CDI.
enum ConvencaoRendimento {
  MOVIMENTO_ANTES_DO_RENDIMENTO
  MOVIMENTO_DEPOIS_DO_RENDIMENTO
}

enum TipoMovimentoCaixinha {
  SALDO
  APORTE
  RESGATE
}

model MovimentoCaixinha {
  id            String                @id @default(uuid())
  // dono do dado (spec 06): o código SEMPRE filtra por ele (o Prisma ignora o RLS do Postgres)
  userId        String?
  user          User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  caixinhaId    String
  caixinha      Caixinha              @relation(fields: [caixinhaId], references: [id], onDelete: Cascade)
  tipo          TipoMovimentoCaixinha
  data          DateTime              @db.Date
  valorCentavos Int
  // só SALDO: desde quando o dinheiro já estava aplicado (define a idade para o IR); padrão = data
  dataOrigem    DateTime?             @db.Date
  // vínculo opcional com a transação do sync (automação assistida)
  transacaoId   String?               @unique
  transacao     Transacao?            @relation(fields: [transacaoId], references: [id], onDelete: SetNull)
  criadoEm      DateTime              @default(now())

  @@index([caixinhaId, data])
  @@index([userId])
}

// CDI diário (série 12 do BCB, % ao dia) guardado como inteiro x10^8: 0,055131% a.d. => 55131
model CdiDia {
  data   DateTime @id @db.Date
  taxaE8 Int
}

enum TipoImposto {
  IR
  IOF
}

// Tabela de alíquotas por idade do lote, editável pelo usuário.
model FaixaImposto {
  id         String      @id @default(uuid())
  tipo       TipoImposto
  // idade máxima do lote em dias (null = sem limite; só a última faixa)
  ateDias    Int?
  aliquotaBp Int

  @@unique([tipo, ateDias])
}

// --- Aviso de conexão do Pluggy (spec aviso-conexao-pluggy) ---

// Retrato do estado do item do Pluggy, gravado a cada sync. SÓ códigos e datas: nunca a mensagem de erro,
// o statusDetail nem o conteúdo de userAction (podem trazer texto do banco ou link de autorização).
model ConexaoPluggy {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId                String    @db.VarChar(64)
  // código do Pluggy (UPDATED, LOGIN_ERROR, ...)
  statusItem            String?   @db.VarChar(40)
  statusExecucao        String?   @db.VarChar(40)
  consentimentoExpiraEm DateTime?
  ultimaAtualizacaoEm   DateTime?
  proximaAtualizacaoEm  DateTime?
  autoSyncDesativadoEm  DateTime?
  falhasDeLogin         Int?
  // só se há userAction pendente, nunca o conteúdo
  acaoPendente          Boolean   @default(false)
  // última leitura BEM-SUCEDIDA do item pelo Solidus
  verificadoEm          DateTime?
  // só o code (ex.: PLUGGY_INDISPONIVEL), nunca a mensagem do Pluggy
  erroVerificacao       String?   @db.VarChar(60)
  atualizadoEm          DateTime  @updatedAt
}

// --- Reserva de emergência (spec reserva-emergencia) ---

enum BaseGastoReserva {
  BRUTA
  LIQUIDA
}

// Configuração da reserva de emergência. Sem linha, valem os padrões (6 meses, base BRUTA, janela de 6).
// A política de investimento completa (spec futura) pode absorver esta tabela.
model ConfiguracaoReserva {
  id           String           @id @default(uuid())
  userId       String           @unique
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  meses        Int              @default(6)
  base         BaseGastoReserva @default(BRUTA)
  janelaMeses  Int              @default(6)
  atualizadoEm DateTime         @updatedAt
}
