// Schema do Solidus. Ainda SEM models de negocio (base de infraestrutura apenas) — cada model
// entra junto da spec que o justifica (01-fundacao-auth e a primeira).
//
// Padrao de RLS obrigatorio (ARCHITECTURE.md secao de banco): toda migration que CRIA uma tabela
// termina com, para aquela tabela:
//   ALTER TABLE "NomeDaTabela" ENABLE ROW LEVEL SECURITY;
//   REVOKE ALL ON "NomeDaTabela" FROM anon, authenticated;
// Sem policy nenhuma — o Prisma conecta como role `postgres` (dono do schema) e ignora RLS; o RLS
// aqui existe so para fechar a Data API do Supabase (nao usada por este projeto) e qualquer acesso
// futuro por anon/authenticated. `pnpm db:check-rls` falha o CI/local se alguma tabela ficar sem
// RLS ou com grant residual para essas duas roles.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Transaction pooler (6543, pgbouncer=true&connection_limit=1) — usado em runtime pela API.
  url       = env("DATABASE_URL")
  // Session pooler (5432) — usado só pelo Prisma Migrate (migrations precisam de sessão longa).
  directUrl = env("DIRECT_URL")
}

// Usuário único, criado pelo seed (spec 01-fundacao-auth). Registro pela API continua fechado.
model User {
  id           String   @id @default(uuid())
  email        String   @unique @db.VarChar(254)
  senhaHash    String   @db.VarChar(255)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  sessoes RefreshSession[]
}

enum ClienteSessao {
  WEB
  PWA
}

// Uma sessão por login/dispositivo (múltiplas sessões simultâneas). O token em claro NUNCA é
// gravado — só o hash SHA-256 (hex, 64 chars), igual qualquer outro segredo de uso único.
// expiraEm null = sessão PWA, sem TTL por tempo (só revogada por logout, reuso detectado, ou
// limpeza manual direto no banco — spec 01-fundacao-auth, "Fora de escopo").
model RefreshSession {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cliente    ClienteSessao
  tokenHash  String        @db.Char(64)
  criadoEm   DateTime      @default(now())
  expiraEm   DateTime?
  revogadoEm DateTime?

  @@index([userId])
  @@index([tokenHash])
}

// --- Sync com o Pluggy (spec 02-sync-pluggy). Dinheiro sempre em centavos (Int). ---

enum TipoConta {
  CORRENTE
  POUPANCA
  CARTAO
}

enum TipoTransacao {
  DEBITO
  CREDITO
}

enum StatusTransacao {
  PENDENTE
  EFETIVADA
}

enum StatusSync {
  SUCESSO
  FALHA
}

model Conta {
  id              String      @id @default(uuid())
  pluggyAccountId String      @unique
  tipo            TipoConta
  nome            String      @db.VarChar(120)
  saldoCentavos   Int
  moeda           String      @db.VarChar(3)
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt
  transacoes      Transacao[]
}

model Transacao {
  id                  String             @id @default(uuid())
  pluggyTransactionId String             @unique
  contaId             String
  conta               Conta              @relation(fields: [contaId], references: [id], onDelete: Cascade)
  data                DateTime
  descricao           String             @db.VarChar(500)
  // negativo = saída, positivo = entrada; o sinal vem do `type` do Pluggy, nunca do valor cru
  valorCentavos       Int
  tipo                TipoTransacao
  status              StatusTransacao
  moeda               String             @db.VarChar(3)
  // dado auxiliar do Pluggy; a categoria do Solidus vem da spec 03-categorizacao
  categoriaPluggy     String?            @db.VarChar(120)
  // categoria do Solidus (id da taxonomia em packages/shared, validado no código) — spec 03
  categoria           String?            @db.VarChar(40)
  origemCategoria     OrigemCategoria?
  criadoEm            DateTime           @default(now())
  atualizadoEm        DateTime           @updatedAt
  movimentoCaixinha   MovimentoCaixinha?

  @@index([contaId, data])
  @@index([data])
  @@index([categoria])
}

model SyncRun {
  id                    String     @id @default(uuid())
  iniciadoEm            DateTime   @default(now())
  finalizadoEm          DateTime?
  status                StatusSync
  contas                Int        @default(0)
  transacoesNovas       Int        @default(0)
  transacoesAtualizadas Int        @default(0)
  // só o code do erro (ex.: PLUGGY_INDISPONIVEL), nunca a mensagem do Pluggy
  erro                  String?    @db.VarChar(60)
}

// --- Categorização (spec 03-categorizacao) ---

enum OrigemCategoria {
  REGRA_USUARIO
  REGRA_PADRAO
  MANUAL
}

model RegraCategoria {
  id               String         @id @default(uuid())
  padrao           String         @db.VarChar(120)
  categoria        String         @db.VarChar(40)
  tipo             TipoTransacao?
  // faixa opcional sobre o MÓDULO do valor (ex.: salário ≈ R$ 1.044), em centavos
  valorMinCentavos Int?
  valorMaxCentavos Int?
  prioridade       Int            @default(0)
  criadoEm         DateTime       @default(now())
}

// --- Carteira por Caixinha (spec 05-carteira-caixinhas). Nada fixo no código: Caixinhas, percentuais e
// alíquotas de IR/IOF são dados editáveis. Dinheiro em centavos (Int); CDI como inteiro x10^8. ---

model Caixinha {
  id                  String               @id @default(uuid())
  nome                String               @db.VarChar(60)
  // 11500 = 115% do CDI; 0 = não rende
  percentualCdiBp     Int
  // conta no patrimônio, mas é verba para gastar no mês (não é "investido")
  reservaDeGastos     Boolean              @default(false)
  // null = convenção padrão do app; o usuário muda se a conferência (GET /caixinhas/:id/conferencia)
  // mostrar que o banco dele credita de outro jeito
  convencaoRendimento ConvencaoRendimento?
  ativa               Boolean              @default(true)
  criadoEm            DateTime             @default(now())
  atualizadoEm        DateTime             @updatedAt
  movimentos          MovimentoCaixinha[]
}

// Em que ordem, no mesmo dia, entram aporte/resgate e o rendimento do CDI.
enum ConvencaoRendimento {
  MOVIMENTO_ANTES_DO_RENDIMENTO
  MOVIMENTO_DEPOIS_DO_RENDIMENTO
}

enum TipoMovimentoCaixinha {
  SALDO
  APORTE
  RESGATE
}

model MovimentoCaixinha {
  id            String                @id @default(uuid())
  caixinhaId    String
  caixinha      Caixinha              @relation(fields: [caixinhaId], references: [id], onDelete: Cascade)
  tipo          TipoMovimentoCaixinha
  data          DateTime              @db.Date
  valorCentavos Int
  // só SALDO: desde quando o dinheiro já estava aplicado (define a idade para o IR); padrão = data
  dataOrigem    DateTime?             @db.Date
  // vínculo opcional com a transação do sync (automação assistida)
  transacaoId   String?               @unique
  transacao     Transacao?            @relation(fields: [transacaoId], references: [id], onDelete: SetNull)
  criadoEm      DateTime              @default(now())

  @@index([caixinhaId, data])
}

// CDI diário (série 12 do BCB, % ao dia) guardado como inteiro x10^8: 0,055131% a.d. => 55131
model CdiDia {
  data   DateTime @id @db.Date
  taxaE8 Int
}

enum TipoImposto {
  IR
  IOF
}

// Tabela de alíquotas por idade do lote, editável pelo usuário.
model FaixaImposto {
  id         String      @id @default(uuid())
  tipo       TipoImposto
  // idade máxima do lote em dias (null = sem limite; só a última faixa)
  ateDias    Int?
  aliquotaBp Int

  @@unique([tipo, ateDias])
}
