{
  "name": "solidus",
  "private": true,
  "version": "0.1.0",
  "description": "Solidus - app pessoal de financas (somente leitura)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "pnpm --filter @solidus/shared run build",
    "dev": "concurrently -n shared,api -c gray,cyan \"pnpm:dev:shared\" \"pnpm:dev:api\"",
    "dev:shared": "pnpm --filter @solidus/shared run dev",
    "dev:api": "pnpm --filter @solidus/api run dev",
    "build": "pnpm --filter @solidus/shared run build && pnpm --filter @solidus/api run build",
    "typecheck": "pnpm --filter @solidus/shared run build && pnpm -r run typecheck",
    "pretest": "pnpm --filter @solidus/shared run build",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @solidus/api run db:generate",
    "db:migrate": "pnpm --filter @solidus/api run db:migrate",
    "db:deploy": "pnpm --filter @solidus/api run db:deploy",
    "db:seed": "pnpm --filter @solidus/api run db:seed",
    "db:check-rls": "pnpm --filter @solidus/api run db:check-rls",
    "db:studio": "pnpm --filter @solidus/api run db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
