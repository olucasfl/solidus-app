# --- App ---
# development | test | production
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# --- Banco (Supabase) ---
# Preencha [YOUR-PASSWORD] com a senha do banco. Se tiver caracteres especiais, faca URL-encode.
# App usa o Transaction Pooler (6543); Prisma Migrate usa o Session Pooler (5432).
DATABASE_URL="postgresql://postgres.qiectnjfxpvdhrglgarl:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.qiectnjfxpvdhrglgarl:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Auth (segredos gerados localmente) ---
JWT_ACCESS_SECRET=<gerado>
JWT_REFRESH_SECRET=<gerado>
# Usuario unico criado pelo seed: preencha voce
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# --- Pluggy (preencha voce) ---
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_ID=

# --- Cron externo (chama POST /sync com este token) ---
SYNC_CRON_TOKEN=<gerado>

# --- Deploy atrás de proxy (Render etc.) ---
# Quantos proxies confiáveis entre o cliente e a API. Deixe AUSENTE em dev. Em produção, o número
# MEDIDO (nunca chute, nunca "true"): sem ele o limite de tentativas vira um só para o site todo.
# TRUST_PROXY_HOPS=

# --- Fase 4 (deixe vazio por enquanto) ---
OPENAI_API_KEY=
